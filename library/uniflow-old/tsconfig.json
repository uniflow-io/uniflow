{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react",
    "outDir": "./dist",

    "strict": true,
    "strictPropertyInitialization": false,

    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "jest"
    ],

    "esModuleInterop": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "./src/**/*.ts",
    "./node_modules/node_modules/@uniflow-io/uniflow-api/src/**/*.ts",
    "./node_modules/node_modules/@uniflow-io/uniflow-client/src/**/*.ts",
  ],
  "exclude": [
    "./.cache/**/*",
    "./dist/**/*",
    "./node_modules/**/*",
    "./**/*.spec.ts"
  ]
}
