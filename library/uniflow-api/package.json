{
  "name": "@uniflow-io/uniflow-api",
  "version": "1.1.15",
  "description": "Uniflow api",
  "author": {
    "name": "Mathieu Ledru",
    "email": "matyo91@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/uniflow-io/uniflow/issues"
  },
  "homepage": "https://github.com/uniflow-io/uniflow/tree/1.x/library/uniflow-api#readme",
  "keywords": [
    "uniflow"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/uniflow-io/uniflow.git",
    "directory": "library/uniflow-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "main": "dist/main.ts",
  "types": "dist/main.d.ts",
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "public"
  ],
  "oclif": {
    "commands": "./dist/command",
    "bin": "uniflow-api"
  },
  "bin": "./bin/uniflow-api",
  "scripts": {
    "prepack": "make build",
    "start": "run-script-os",
    "start:default": "cd bin && ./uniflow-api",
    "start:windows": "cd bin && uniflow-api",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ignore-path .gitignore --ext .ts,.tsx,.js",
    "prettier": "prettier \"**/*.{md,css,scss,yaml,yml}\""
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@oclif/command": "^1.8.36",
    "@oclif/errors": "^1.3.6",
    "argon2": "0.41.1",
    "axios": "^1.8.4",
    "body-parser": "1.20.3",
    "convict": "^6.2.4",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-openapi": "^12.1.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "md5": "^2.3.0",
    "mongodb": "6.15.0",
    "mysql": "^2.18.1",
    "nodemailer": "^6.10.0",
    "open": "^10.1.0",
    "reflect-metadata": "0.2.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "slugify": "^1.6.6",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "typedi": "0.10.0",
    "typeorm": "0.3.21",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@oclif/dev-cli": "^1.26.10",
    "@types/chai": "^5.2.0",
    "@types/convict": "^6.1.6",
    "@types/cors": "2.8.17",
    "@types/dotenv": "8.2.3",
    "@types/express": "5.0.1",
    "@types/express-jwt": "7.4.4",
    "@types/faker": "^6.6.11",
    "@types/helmet": "4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/md5": "^2.3.5",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "1.9.9",
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "chai": "^5.2.0",
    "faker": "^6.6.6",
    "jest": "^29.7.0",
    "mocha": "^11.1.0",
    "nodemon": "^3.1.9",
    "run-script-os": "^1.1.6",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "ts-node": "10.9.2",
    "typescript": "^5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFilesAfterEnv": [
      "./tests/hooks.ts"
    ]
  }
}
